services:
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: sovereign-backend
    ports:
      - "8000:8000"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    # All model settings, inference endpoints, credentials, and custom flags
    # are loaded directly from backend/.env. To change the LLM model, simply
    # update LLM_MODEL in backend/.env — no edits to docker-compose.yml needed.
    env_file:
      - ./backend/.env
    environment:
      - HOST=0.0.0.0
      - PORT=8000
      - RUNNING_IN_DOCKER=true
      # --- Encryption layer defaults (can be overridden in backend/.env) ---
      - ENCRYPTION_DATA_DIR=/data
      - HE_CONTEXT_FILE=/data/he/he_context.enc
      - HE_POLY_MODULUS_DEGREE=8192
      - HE_COEFF_MOD_BIT_LENGTHS=[60, 40, 40, 60]
      - HE_THREADS=1
      - DIFFERENTIAL_PRIVACY_ENABLED=true
      - DP_EPSILON=5000
      - DP_DELTA=1e-5
      - EMBED_MODEL=nomic-embed-text
    volumes:
      # Named volume, not a file bind-mount: binding a host file that does not exist yet
      # makes Docker create a *directory* at that path and context loading fails.
      - sovereign-crypto:/data
    restart: unless-stopped

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        - VITE_API_URL=http://localhost:8000
    container_name: sovereign-frontend
    ports:
      - "5173:80"
    depends_on:
      - backend
    restart: unless-stopped

volumes:
  # Holds the sealed CKKS context, the ciphertext vault and the audit log.
  # Back it up together with ENCRYPTION_MASTER_KEY (stored separately).
  sovereign-crypto:
