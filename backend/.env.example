# Sovereign Industrial Agentic Workbench Configuration
# Copy to backend/.env and fill in. backend/.env is git-ignored and docker-ignored.
# Do not indent lines: docker compose's env_file parser is stricter than python-dotenv.

# Server Host & Port (bare-metal runs). Under docker compose, HOST is forced to 127.0.0.1 so the
# API is reachable only through Nginx on :443. Use 127.0.0.1 here too unless you need LAN access.
HOST=127.0.0.1
PORT=8000

# CORS: exact origins, comma separated. Empty = https://localhost, https://127.0.0.1 and the Vite
# dev server; SERVER_LAN_IP (written to ./.env by scripts/gen_tls_cert.sh) adds https://<LAN_IP>.
# CORS_ALLOW_ORIGINS=

# Open-Weight LLM Inference Endpoint (LM Studio, Ollama, vLLM, or OpenAI-compatible)
# Bare-metal local default: http://localhost:11434/v1 (Ollama) or http://localhost:1234/v1 (LM Studio)
# Note: When running inside Docker, requests to localhost automatically resolve to host.docker.internal.
# Change LLM_MODEL here to switch models across both local Python and Docker Compose environments.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama

# Centralized Atomic MCP (Model Context Protocol) Knowledge Graph Server
MCP_URL=http://localhost:8080/mcp
MCP_AUTH_HEADER=Bearer <atomic-api-token>

# Academic Grounding API (SerpAPI Google Scholar) - NOTE: this is an outbound internet call
SERPAPI_KEY=<serpapi-key-or-empty-when-air-gapped>

# ---------------------------------------------------------------------------
# Encryption layer
# ---------------------------------------------------------------------------
# Master switch. false = original plaintext behaviour (backward compatible).
ENCRYPTION_ENABLED=true

# Root secret (Fernet-format, 32 random bytes). All other keys are derived from it.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes every encrypted document unrecoverable. Back it up offline.
ENCRYPTION_MASTER_KEY=

# Where the sealed HE context, ciphertext vault and audit log live.
# Docker: /data (named volume). Bare metal: a local folder.
ENCRYPTION_DATA_DIR=./data
# HE_CONTEXT_FILE=./data/he/he_context.enc   # default: $ENCRYPTION_DATA_DIR/he/he_context.enc
# HE_VAULT_PATH=./data/he/vault.sqlite3
# AUDIT_LOG_PATH=./data/audit/encryption_audit.jsonl

# Homomorphic Encryption (CKKS via TenSEAL)
HE_POLY_MODULUS_DEGREE=8192
HE_COEFF_MOD_BIT_LENGTHS=[60, 40, 40, 60]
HE_GLOBAL_SCALE_BITS=40
HE_THREADS=1
HE_SEARCH_TOP_K=5
HE_CACHE_MAX_MB=512

# Differential Privacy (Laplace mechanism, per-embedding local DP)
# READ docs/ENCRYPTION_SECURITY_REPORT.md §6 before choosing epsilon.
# DP_EPSILON=1.0 produces random results (recall@1 = 0 on 768-d vectors).
# DP_EPSILON=5000 gives full recall while still blunting embedding-inversion
# (vec2text-style) attacks if the CKKS key ever leaks.
# Measure on your own documents first:
#   python scripts/bench_dp_utility.py --ollama http://localhost:11434 --pairs pairs.jsonl
DIFFERENTIAL_PRIVACY_ENABLED=true
DP_EPSILON=5000
DP_DELTA=1e-5
DP_APPLY_TO_QUERIES=true

# Local embedding model served by Ollama (ollama pull nomic-embed-text)
EMBED_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://localhost:11434/v1   # defaults to LLM_BASE_URL
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
MAX_CHUNKS_PER_DOC=400
MAX_UPLOAD_MB=25
# Folder the agent's ingest_pdf tool may read (plain file names only, .pdf/.txt/.md).
# Default: $ENCRYPTION_DATA_DIR/inbox  (in Docker: /data/inbox)
# INGEST_INBOX_DIR=./data/inbox

# OCR fallback for scanned PDFs: pages with fewer than PDF_OCR_MIN_CHARS characters of pypdf text
# are OCR'd locally with Tesseract (eng). 0 disables OCR. PDF_OCR_MAX_PAGES caps OCR'd pages per
# PDF (0 = no limit; OCR takes roughly 2-5 s per page on a laptop CPU).
PDF_OCR_MIN_CHARS=50
PDF_OCR_MAX_PAGES=0

# --- Query router (backend/router.py; rules are data in backend/router_rules.json) ---
# coding -> agent with only run_python_sandboxed; document/knowledge/general -> the normal agent.
# Fallback for queries no keyword rule matches: embedding similarity via the local embedder.
ROUTER_EMBED_FALLBACK=false
# ROUTER_RULES_PATH=./router_rules.json   # use an edited copy of the rules file

# --- Vision descriptions for PDF pages with images (off by default) ---
# Pages with embedded images are rendered and described by VISION_MODEL at LLM_BASE_URL. Refused
# unless LLM_BASE_URL is a loopback address (localhost/127.0.0.0/8/::1) or VISION_ALLOW_REMOTE=true.
# Unreachable or slow endpoint -> text-only ingestion plus a warning; ingestion never fails.
PDF_VISION_ENABLED=false
VISION_ALLOW_REMOTE=false
# VISION_MODEL=qwen2.5vl:3b
# VISION_TIMEOUT_S=60

# --- Code sandbox (docs/SANDBOX.md) ---
# The backend reaches sandbox-runner only through this Unix socket (sandbox-ipc volume); compose sets it.
# SANDBOX_SOCKET=/ipc/runner.sock
# Runner-side settings are in docker-compose.yml: SANDBOX_IMAGE=python:3.11-slim, SANDBOX_MAX_CONCURRENT=2.
# Fixed limits (not configurable): code 20 KB, timeout <= 10 s, output 16 KB, 256 MB RAM, 0.5 CPU,
# 64 processes, no network, read-only root, /work tmpfs 32 MB, user 65534.
